FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
PORT=8080
NEWS_OFFICER_MESSAGE_WORKERS=4
OPENAI_API_KEY=replace_me
# Optional expression advisor. Sends current question + bounded last two turns
# to DeepSeek; never sends the full transcript library. Configure in cloud Secrets.
DEEPSEEK_API_KEY=
NEWS_OFFICER_TONE_ADVISOR=false
NEWS_OFFICER_TONE_MODEL=deepseek-flash
# Daily evidence-grounded star rating; low-star episodes are still included.
NEWS_OFFICER_EDITORIAL_FILTER=true
# Private persistent JSON profile, never commit its company list to the repo.
NEWS_OFFICER_RESEARCH_FOCUS_PATH=
# Optional Podwise Pro/Enterprise token; never commit it or paste it into chat.
PODWISE_API_TOKEN=
# Opt in to processing missing tracked RSS transcripts using existing credits.
# No purchases, imports, automatic failed-job restarts, or repeat billable POSTs.
PODWISE_AUTO_PROCESS=false

# Optional initial daily subscribers. Users/groups can later subscribe in Feishu.
# Comma-separate multiple values; an in-chat opt-out persists across restarts.
FEISHU_USER_OPEN_IDS=ou_xxx
FEISHU_GROUP_CHAT_IDS=oc_xxx

OPENAI_MODEL=gpt-5.6-terra
NEWS_OFFICER_DAILY_TIME=08:30
# Scheduled discovery and transcript retrieval never call YouTube when true.
# Explicit user-submitted YouTube links remain supported; Podwise precedes captions.
NEWS_OFFICER_DAILY_RSS_ONLY=true
NEWS_OFFICER_TIMEZONE=Asia/Shanghai
NEWS_OFFICER_LOOKBACK_HOURS=72
# 0 = all discovered, unseen episodes within the lookback window.
NEWS_OFFICER_MAX_SUMMARIES=0
NEWS_OFFICER_MAX_CANDIDATES=0
NEWS_OFFICER_DAILY_TRANSCRIPT_ATTACHMENTS=false
NEWS_OFFICER_DAILY_COMBINED_MESSAGE=true
NEWS_OFFICER_DB_PATH=/data/news-officer.sqlite3
NEWS_OFFICER_MEMORY_PATH=/data/podcast-memory
# Optional one-time, idempotent backfill. Change the ID only for an intentional rerun.
# NEWS_OFFICER_MANUAL_DIGEST_ID=2026-09-15-rss-backfill

# Tool-using agent; public podcast mode does not require Drive permissions.
NEWS_OFFICER_RESEARCH_AGENT=false
NEWS_OFFICER_KNOWLEDGE_MODE=podcast_archive
# Dedicated bot-created Feishu Drive folder; not a Wiki token.
NEWS_OFFICER_LIBRARY_FOLDER=
# Explicit data-access allowlists, independent of daily-push subscriptions.
NEWS_OFFICER_RESEARCH_USERS=
NEWS_OFFICER_RESEARCH_CHATS=
