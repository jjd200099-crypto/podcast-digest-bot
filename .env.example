FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
PORT=8080
NEWS_OFFICER_MESSAGE_WORKERS=4
OPENAI_API_KEY=replace_me
# Optional expression advisor. Sends current question + bounded last two turns
# to DeepSeek; never sends the full transcript library. Configure in cloud Secrets.
DEEPSEEK_API_KEY=
NEWS_OFFICER_TONE_ADVISOR=false
NEWS_OFFICER_TONE_MODEL=deepseek-flash
# Daily evidence-grounded star rating; low-star episodes are still included.
NEWS_OFFICER_EDITORIAL_FILTER=true
# Private persistent JSON profile, never commit its company list to the repo.
NEWS_OFFICER_RESEARCH_FOCUS_PATH=
# Optional Podwise Pro/Enterprise token; never commit it or paste it into chat.
PODWISE_API_TOKEN=
# Opt in to processing missing tracked RSS transcripts using existing credits.
# No purchases, imports, automatic failed-job restarts, or repeat billable POSTs.
PODWISE_AUTO_PROCESS=false

# Optional initial daily subscribers. Users/groups can later subscribe in Feishu.
# Comma-separate multiple values; an in-chat opt-out persists across restarts.
FEISHU_USER_OPEN_IDS=ou_xxx
FEISHU_GROUP_CHAT_IDS=oc_xxx

OPENAI_MODEL=gpt-5.6-terra
# Daily delivery time (HH:MM in NEWS_OFFICER_TIMEZONE). Default 08:30, configurable.
NEWS_OFFICER_DAILY_TIME=08:30
# Optional daily recipient allowlist: comma-separated oc_ group chat IDs. When set,
# ONLY these chats get the daily and document links; FEISHU_USER_OPEN_IDS and
# private 'subscribe' entries never receive it. When empty, the daily falls back to
# all active subscriptions (a WARNING is logged and shown in operations status).
# Separate from NEWS_OFFICER_WATCH_CHAT_ID (the watchdog's chat to inspect).
NEWS_OFFICER_DAILY_CHAT_IDS=
# Default false. Set true once the allowlist is configured: an empty/invalid
# allowlist then makes the daily job fail loudly and send nothing.
NEWS_OFFICER_DAILY_REQUIRE_CHAT_IDS=false
# Default false. true appends a feature update to the first eligible non-reader daily.
NEWS_OFFICER_DAILY_RELEASE_NOTES=false
# Optional bounded warm-up two hours before the morning delivery; never sends.
NEWS_OFFICER_DAILY_PREPARATION=false
# Optional comma-separated replacement for discovery topics (max 24, 80 chars each).
NEWS_OFFICER_DISCOVERY_TOPICS=
# Scheduled discovery and transcript retrieval never call YouTube when true.
# Explicit user-submitted YouTube links remain supported; Podwise precedes captions.
NEWS_OFFICER_DAILY_RSS_ONLY=true
NEWS_OFFICER_TIMEZONE=Asia/Shanghai
NEWS_OFFICER_LOOKBACK_HOURS=72
# 0 = all discovered, unseen episodes within the lookback window.
NEWS_OFFICER_MAX_SUMMARIES=0
NEWS_OFFICER_MAX_CANDIDATES=0
NEWS_OFFICER_DAILY_TRANSCRIPT_ATTACHMENTS=false
NEWS_OFFICER_DAILY_COMBINED_MESSAGE=true
# One reader-facing edition, including compiled links; no catch-up/status broadcasts.
NEWS_OFFICER_DAILY_READER_MODE=true
# Optional read-only exploration outside subscribed RSS feeds. Requires Podwise
# token and editorial review; does not follow channels or submit paid transcripts.
NEWS_OFFICER_PODWISE_DISCOVERY=false
# Optional independent Feishu shownotes documents for selected daily episodes.
# 文档完成后编辑原日报补入链接，不另发文档链接消息。
# Root of bot Drive by default; optionally specify a bot-writable folder token.
NEWS_OFFICER_DAILY_DOCUMENT=false
# First edition date YYYY-MM-DD; only the latest seven days are considered.
NEWS_OFFICER_DAILY_DOCUMENT_START_DATE=
NEWS_OFFICER_DAILY_DOCUMENT_FOLDER=
NEWS_OFFICER_DAILY_DOCUMENT_MIN_STARS=4
# Enable only after confirming full-text republication rights for the target audience.
# Reuses verified originals; does not imply a Chinese translation.
NEWS_OFFICER_DAILY_DOCUMENT_FULLTEXT=false
NEWS_OFFICER_DB_PATH=/data/news-officer.sqlite3
NEWS_OFFICER_MEMORY_PATH=/data/podcast-memory
# Optional one-time, idempotent backfill. Change the ID only for an intentional rerun.
# NEWS_OFFICER_MANUAL_DIGEST_ID=2026-09-15-rss-backfill

# Tool-using agent; public podcast mode does not require Drive permissions.
NEWS_OFFICER_RESEARCH_AGENT=false
NEWS_OFFICER_KNOWLEDGE_MODE=podcast_archive
# Dedicated bot-created Feishu Drive folder; not a Wiki token.
NEWS_OFFICER_LIBRARY_FOLDER=
# Explicit data-access allowlists, independent of daily-push subscriptions.
NEWS_OFFICER_RESEARCH_USERS=
NEWS_OFFICER_RESEARCH_CHATS=

# Per episode document revision; invalid values fall back to 3.
NEWS_OFFICER_DAILY_DOCUMENT_MAX_ATTEMPTS=3

# Opt-in prose compression; off by default. 1 or true enables it.
NEWS_OFFICER_DAILY_COMPACT_PARAGRAPHS=false
NEWS_OFFICER_DAILY_COMPACT_TARGET_RATIO=0.4

# Opt into evidence-aware daily selection; default preserves legacy policy.
NEWS_OFFICER_STRICT_SELECTION=false

# 精读仅支持详细核心内容＋按原始顺序整理的中文 QA。
# NEWS_OFFICER_DEEPREAD_NEW_STYLE 已删除；false（或非 true 值）会导致启动失败。

# Opt-in blogs/newsletters; default off
NEWS_OFFICER_TEXT_SOURCES=false

# YouTube Podwise fallback reads verified assets for free by default.
# Paid processing requires BOTH settings; cap counts reservations per UTC day.
NEWS_OFFICER_YOUTUBE_PODWISE_PROCESS=false
NEWS_OFFICER_YOUTUBE_PODWISE_DAILY_MAX=0

# Morning reader layout; compact/false restores the previous path.
NEWS_OFFICER_DAILY_LAYOUT=v4

# RSS newness: seed existing items, then allow recently first-seen backdated items.
NEWS_OFFICER_RSS_FIRST_SEEN=1
NEWS_OFFICER_FIRST_SEEN_MAX_AGE_DAYS=45
NEWS_OFFICER_FIRST_SEEN_BURST_LIMIT=3
